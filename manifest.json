{
  "manifest_version": 3,
  "name": "Slack Quote Reply",
  "version": "0.1.0",
  "description": "One-click quote-reply for Slack web.",
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["loader.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["src/*.js"], "matches": ["https://app.slack.com/*"] }
  ]
}
